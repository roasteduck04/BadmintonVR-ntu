# Unity generated / cache folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Recordings can get excessive in size
[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db

# Raw capture videos (large binaries; keep cloud backups instead)
data/raw/

# Python
tools/.venv/
__pycache__/
*.pyc

# MakeHuman installation (large binary, reinstall locally)
tools/makehuman/
tools/makehuman-community/
tools/Python/
tools/pkgs/
tools/uninstall.exe
tools/_user_install_marker
tools/mhstartwrapper.py
tools/makehuman.ico
tools/LICENSE.md

# Privacy: frame-bearing images (video frames of people/places) stay local
data/**/*.png
data/**/*.jpg
# ...and frame-bearing VIDEO. Debug/overlay renders land in data/<tool>/ (e.g.
# data/racket/test_6_racket_overlay.mp4) and are just as identifying as a frame.
data/**/*.mp4
data/**/*.mov
data/calib/archive/
docs/img/

# Third-party avatar model (unclear redistribution license) — supply your own
Assets/Avatar/character.fbx
Assets/Avatar/character.fbx.meta

# Model weights (auto-downloaded by tools/detect_racket.py)
*.pt

# License-gated SMPL body models + large staging (register at smpl.is.tue.mpg.de).
# NEVER commit — the repo is public and these carry the SMPL Model License.
models/
downloads/

# License-gated evaluation datasets (3DPW: register at virtualhumans.mpi-inf.mpg.de/3dpw).
# NEVER commit — the repo is public and redistribution is not permitted. The derived
# GT .npz is a transform of licensed annotations, so it is covered too.
data/3dpw/
data/*.zip
data/gt/

# Move-label debug overlays (frame-bearing video)
data/moves/

.superpowers/
.claude/

# Calibration frame images (base64 + jpg) — contain video frames of people/places
data/calib/frames/

# Personal plan + reading (collaborator/institution names live ONLY here) — local only
docs/for-me/

# Render intermediates (panels, joint dumps, saved cameras) — the finished mp4/png beside
# them are already covered by the image/video rules above.
data/render/_*

# Generated HTML analysis reports (may carry player frames/overlays in later phases)
data/reports/

# GPU inference outputs (large JSONs, regenerated from videos)
data/pose2d/
data/racket2d/
data/shuttle/
data/analysis/
Assets/StreamingAssets/analysis/

# Archive: frame-bearing images/videos (same privacy rule as data/**)
_archive/**/*.png
_archive/**/*.jpg
_archive/**/*.mp4
_archive/**/*.mov

# ML model weights (downloaded on first use, too large to commit)
tools/selfie_multiclass_256x256.tflite
tools/weights/
tools/face_landmarker.task

# pipeline inputs / outputs made on the PC (not part of the repo)
data/15-08/
data/pose2d*/
data/pose_cache/
data/pose_eval/
results/
.venv*/
Assets/StreamingAssets/analysis/*.json
